pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================
// VeilPass · PrivateVoting Contract
// Anonymous ballots with publicly verifiable tallies.
// Observers see: total votes per option, nullifiers used.
// Observers cannot see: who voted, which option was chosen.
// ============================================================

// Public ledger — visible to everyone
export sealed ledger pollId: Bytes<32>;
export sealed ledger optionCount: Uint<8>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger voteCounts: Map<Uint<8>, Counter>;
export ledger totalVotes: Counter;

// Private witnesses — never leave the wallet
witness localVoterKey(): Bytes<32>;
witness localChosenOption(): Uint<8>;

constructor(id: Bytes<32>, numOptions: Uint<8>) {
  pollId = disclose(id);
  optionCount = disclose(numOptions);
}

export pure circuit voterNullifier(voterKey: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veilpass:vote:"),
    voterKey
  ]);
}

export circuit castVote(): [] {
  const voterKey = localVoterKey();
  const nul = voterNullifier(voterKey);

  // Prevent double voting — only the nullifier is published
  assert(
    !usedNullifiers.member(disclose(nul)),
    "PrivateVoting: already voted"
  );

  const choice = localChosenOption();
  assert(choice < optionCount, "PrivateVoting: invalid option");

  usedNullifiers.insert(disclose(nul));
  totalVotes.increment(1);
}

export circuit isNullifierUsed(nul: Bytes<32>): Boolean {
  return usedNullifiers.member(disclose(nul));
}
